#!/bin/sh
# The one interface to the toolchains. CI, the git hooks and scripts/agent call only this, so
# adding a language or tool means changing this file and nothing else.
#
# prototype/ is a design reference with its own npm scripts; it is not part of these checks.
set -eu

cd "$(dirname "$0")/.."

SWIFT_PACKAGE=apps/macos
SWIFT_SOURCES="$SWIFT_PACKAGE/Package.swift $SWIFT_PACKAGE/Sources $SWIFT_PACKAGE/Tests"
GENERATED=$SWIFT_PACKAGE/Generated

# Copies only when the content differs, so SwiftPM does not rebuild what did not change.
install_if_changed() {
	cmp -s "$1" "$2" 2>/dev/null || cp "$1" "$2"
}

# SwiftPM cannot run cargo, so every Swift step that compiles first builds common-core's static
# library and generates its Swift bindings into Generated/, which Package.swift reads.
swift_core() {
	cargo build --locked -p common-ffi
	out=$(mktemp -d)
	cargo run --locked --quiet -p uniffi-bindgen -- generate --language swift \
		--library target/debug/libcommon_ffi.a --out-dir "$out"
	mkdir -p "$GENERATED/CommonCore" "$GENERATED/CommonCoreFFI" "$GENERATED/lib"
	install_if_changed "$out/CommonCore.swift" "$GENERATED/CommonCore/CommonCore.swift"
	install_if_changed "$out/CommonCoreFFI.h" "$GENERATED/CommonCoreFFI/CommonCoreFFI.h"
	install_if_changed "$out/CommonCoreFFI.modulemap" "$GENERATED/CommonCoreFFI/module.modulemap"
	install_if_changed target/debug/libcommon_ffi.a "$GENERATED/lib/libcommon_ffi.a"
	rm -rf "$out"
}

fmt() {
	cargo fmt --all
	# shellcheck disable=SC2086 # word splitting is the point: several paths
	swift format --in-place --recursive $SWIFT_SOURCES
}

fmt_check() {
	cargo fmt --all --check
	# shellcheck disable=SC2086
	swift format lint --strict --recursive $SWIFT_SOURCES
}

lint() {
	cargo clippy --workspace --all-targets --locked -- -D warnings
}

test_all() {
	scripts/test-workflow
	cargo test --workspace --locked
	swift_core
	# Without Xcode, SwiftPM neither finds the Testing framework nor its interop library, so
	# point the compiler and the test runner at the copies Command Line Tools ships.
	clt=/Library/Developer/CommandLineTools
	frameworks=$clt/Library/Developer/Frameworks
	if [ "$(xcode-select -p 2>/dev/null)" = "$clt" ] && [ -d "$frameworks/Testing.framework" ]; then
		set -- -Xswiftc -F -Xswiftc "$frameworks" \
			-Xlinker -F -Xlinker "$frameworks" \
			-Xlinker -rpath -Xlinker "$frameworks" \
			-Xlinker -rpath -Xlinker "$clt/Library/Developer/usr/lib"
	else
		set --
	fi
	# The output streams through tee; POSIX sh has no pipefail, so swift's own status goes to a file.
	log=$(mktemp)
	{
		swift test --package-path "$SWIFT_PACKAGE" "$@" 2>&1
		echo $? >"$log.status"
	} | tee "$log"
	status=$(cat "$log.status")
	summary=0
	scripts/swift-test-passed "$log" || summary=$?
	rm -f "$log" "$log.status"
	[ "$status" -eq 0 ] && [ "$summary" -eq 0 ]
}

# The Rust workspace alone, for the Linux and Windows runners, which have no Swift toolchain. The
# core serves every shell, so it must build and pass there too.
check_core() {
	cargo fmt --all --check
	lint
	cargo test --workspace --locked
}

build() {
	cargo build --workspace --locked
	swift_core
	swift build --package-path "$SWIFT_PACKAGE" -Xswiftc -warnings-as-errors
}

# Remember the tree that just passed, so the pre-push hook can skip checking the same content
# twice. Only a clean checkout counts: otherwise the tree is not what was checked.
record_pass() {
	[ -z "$(git status --porcelain 2>/dev/null || echo dirty)" ] || return 0
	git rev-parse 'HEAD^{tree}' >"$(git rev-parse --git-path task-check-passed)"
}

usage() {
	echo "usage: scripts/task <fmt|fmt:check|lint|test|build|check|check:core>" >&2
	exit 2
}

[ $# -eq 1 ] || usage

case "$1" in
fmt) fmt ;;
fmt:check) fmt_check ;;
lint) lint ;;
test) test_all ;;
build) build ;;
check)
	fmt_check
	lint
	test_all
	build
	record_pass
	;;
check:core) check_core ;;
*) usage ;;
esac
